---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: '~/home' },
  { href: '/projects/', label: '~/projects' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="border-b border-border">
  <div class="max-w-3xl mx-auto px-5 h-14 flex items-center justify-between gap-4">
    <a href="/" class="font-mono text-sm text-fg no-underline hover:text-accent"> hyperion0328 </a>
    <nav aria-label="주요">
      <ul class="flex items-center gap-4 list-none m-0 p-0">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={isActive(l.href) ? 'page' : undefined}
                class:list={[
                  'font-mono text-xs no-underline transition-colors hover:text-fg',
                  isActive(l.href) ? 'text-fg' : 'text-faint',
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
