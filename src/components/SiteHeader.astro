---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: '홈' },
  { href: '/projects/', label: '프로젝트' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="border-b border-border">
  <div class="max-w-3xl mx-auto px-5 h-14 flex items-center justify-between gap-4">
    <a href="/" class="font-semibold tracking-tight text-fg no-underline"> 박현민 </a>
    <nav aria-label="주요">
      <ul class="flex items-center gap-4 list-none m-0 p-0">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={isActive(l.href) ? 'page' : undefined}
                class:list={[
                  'text-sm no-underline hover:text-fg transition-colors',
                  isActive(l.href) ? 'text-fg font-medium' : 'text-muted',
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
