---
const path = Astro.url.pathname;
const links = [
  { href: '/projects/', label: '프로젝트' },
  { href: '/motion/', label: '모션그래픽' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const email = 'parkhm1477@gmail.com';
---

{/* MiniMax 마케팅 내비 — 순백 바에 하단 헤어라인, 우측에 검정 알약 CTA */}
<header class="sticky top-0 z-40 bg-canvas border-b border-hairline-soft">
  <div class="max-w-3xl mx-auto px-5 h-16 flex items-center justify-between gap-4">
    <a href="/" class="text-base font-bold tracking-tight text-ink no-underline">박현민</a>

    <nav aria-label="주요" class="flex items-center gap-1 sm:gap-2">
      <ul class="flex items-center gap-1 sm:gap-2 list-none m-0 p-0">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={isActive(l.href) ? 'page' : undefined}
                class:list={[
                  'inline-block px-3 py-2 text-sm no-underline transition-colors rounded-full',
                  isActive(l.href) ? 'text-ink font-semibold' : 'text-steel hover:text-ink',
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={`mailto:${email}`} class="pill pill-primary hidden sm:inline-flex">연락하기</a>
    </nav>
  </div>
</header>
