---
interface Props {
  index: number;
  href: string;
  slug: string;
  title: string;
  tagline: string;
  period: string;
  stack: string[];
  metrics: { label: string; value: string }[];
}

const { href, slug, title, tagline, period, stack, metrics } = Astro.props;
---

{/* MiniMax card-base — 평평한 흰 카드, 16px 모서리, 1px 헤어라인 (elevation 0) */}
<article class="card transition-colors hover:border-ink">
  <div class="flex items-baseline justify-between gap-3">
    <p class="section-label m-0">{slug}</p>
    <p class="text-micro text-stone m-0 whitespace-nowrap">{period}</p>
  </div>

  <h2 class="text-card font-semibold tracking-tight mt-3 mb-0">
    <a href={href} class="text-ink no-underline">{title}</a>
  </h2>
  <p class="text-sm text-slate mt-2 mb-0">{tagline}</p>

  {
    metrics.length > 0 && (
      <dl class="mt-5 mb-0 flex flex-wrap gap-x-8 gap-y-3">
        {metrics.map((m) => (
          <div>
            <dt class="text-micro text-stone m-0">{m.label}</dt>
            <dd class="text-sm font-semibold text-ink m-0 mt-0.5 font-mono tabular-nums">
              {m.value}
            </dd>
          </div>
        ))}
      </dl>
    )
  }

  <ul class="flex flex-wrap gap-2 list-none m-0 mt-5 p-0">
    {
      stack.map((s) => (
        <li class="text-micro text-steel border border-hairline rounded-full px-2.5 py-1">{s}</li>
      ))
    }
  </ul>
</article>
