---
interface Props {
  href: string;
  title: string;
  tagline: string;
  period: string;
  stack: string[];
  headline?: { value: string; label: string };
}

const { href, title, tagline, period, stack, headline } = Astro.props;
---

<article
  class="border border-border rounded-[--radius-card] bg-surface p-5 transition-colors hover:border-accent"
>
  <div class="flex items-baseline justify-between gap-3 flex-wrap">
    <h2 class="text-lg font-semibold m-0">
      <a href={href} class="text-fg no-underline hover:text-accent">
        {title}
      </a>
    </h2>
    <span class="text-xs text-faint whitespace-nowrap">{period}</span>
  </div>

  <p class="text-sm text-muted mt-2 mb-0">{tagline}</p>

  {
    headline && (
      <p class="mt-3 mb-0 text-sm">
        <span class="font-mono text-fg font-medium">{headline.value}</span>
        <span class="text-faint"> · {headline.label}</span>
      </p>
    )
  }

  <ul class="flex flex-wrap gap-1.5 list-none m-0 mt-4 p-0">
    {
      stack.map((s) => (
        <li class="text-xs text-muted border border-border rounded px-2 py-0.5">{s}</li>
      ))
    }
  </ul>
</article>
