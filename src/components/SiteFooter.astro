---
// 연락처는 이메일만 노출한다.
// 전화번호·주소 등 개인정보는 어떤 경우에도 이 사이트에 넣지 않는다.
const email = 'parkhm1477@gmail.com';
const year = new Date().getFullYear();

const links = [
  { href: '/projects/', label: '프로젝트' },
  { href: '/motion/', label: '모션그래픽' },
];
---

{/* MiniMax footer-region — 검정 캔버스에 흰 잉크. 라이트·다크 양쪽에서 동일하다. */}
<footer class="mt-auto bg-[--color-footer-bg] text-on-dark">
  <div class="max-w-3xl mx-auto px-5 py-16">
    <p class="text-card font-bold tracking-tight m-0">박현민</p>
    <p class="text-sm text-on-dark-muted mt-2 mb-0">영상디자인 · AI 응용소프트웨어</p>

    <nav aria-label="바닥글" class="mt-8">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 list-none m-0 p-0">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="text-sm text-on-dark-muted no-underline hover:text-on-dark">
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={`mailto:${email}`}
            class="text-sm text-on-dark-muted no-underline hover:text-on-dark"
          >
            {email}
          </a>
        </li>
      </ul>
    </nav>

    <p class="text-micro text-on-dark-muted mt-12 mb-0">© {year} Park Hyeon Min</p>
  </div>
</footer>
