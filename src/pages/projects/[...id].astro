---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MetricTable from '../../components/MetricTable.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

// 링크 라벨은 고정한다 — 순서도 여기에서 결정된다.
const linkList = [
  { key: 'github', label: 'github', href: d.links.github },
  { key: 'demo', label: 'demo', href: d.links.demo },
  { key: 'docs', label: 'docs', href: d.links.docs },
].filter((l): l is { key: string; label: string; href: string } => Boolean(l.href));

const meta = [
  { k: 'period', v: d.period },
  { k: 'role', v: d.role },
  { k: 'stack', v: d.stack.join(' · ') },
];
---

<BaseLayout title={`${d.title} — 박현민`} description={d.tagline}>
  <article>
    <header>
      <p class="font-mono text-micro text-stone m-0">{project.id}</p>
      <h1 class="text-heading-md font-semibold tracking-tight mt-1 mb-0">{d.title}</h1>
      <p class="text-charcoal mt-2 mb-0">{d.tagline}</p>

      <dl class="mt-6 flex flex-col gap-1.5 m-0 border-t border-hairline pt-4">
        {
          meta.map((m) => (
            <div class="grid grid-cols-[4.5rem_1fr] gap-3 font-mono text-caption">
              <dt class="text-stone">{m.k}</dt>
              <dd class="text-ink m-0">{m.v}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    {/* 1. 문제 정의 */}
    <section class="mt-14">
      <h2 class="section-label">problem</h2>
      <p class="mt-3 mb-0 text-ink">{d.problem}</p>
    </section>

    {/* 2. 접근 방법 — 본문 마크다운 */}
    <section class="mt-14">
      <h2 class="section-label">approach</h2>
      <div class="prose-body mt-3">
        <Content />
      </div>
    </section>

    {/* 3. 결과 — 수치는 측정 조건과 함께만 노출된다 */}
    <section class="mt-14">
      <h2 class="section-label">results</h2>
      <div class="mt-3">
        <MetricTable results={d.results} />
      </div>
      {
        d.resultsNote && (
          <p class="text-sm text-charcoal mt-5 mb-0 border-l-2 border-hairline pl-3">
            {d.resultsNote}
          </p>
        )
      }

      {
        d.figures && (
          <div class="mt-8 flex flex-col gap-8">
            {d.figures.map((f) => (
              <figure class="m-0">
                <Image
                  src={f.src}
                  alt={f.alt}
                  widths={[640, 960, 1280]}
                  sizes="(min-width: 768px) 42rem, 100vw"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto rounded-[--radius-card] border border-hairline bg-surface"
                />
                {f.caption && (
                  <figcaption class="font-mono text-micro text-stone mt-2 leading-relaxed">
                    {f.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        )
      }
    </section>

    {/* 4. 배운 점 */}
    <section class="mt-14">
      <h2 class="section-label">learned</h2>
      <ol class="mt-3 mb-0 flex flex-col gap-3 list-none p-0">
        {
          d.learned.map((l, i) => (
            <li class="grid grid-cols-[2rem_1fr] gap-2">
              <span class="font-mono text-micro text-stone pt-1 tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-charcoal">{l}</span>
            </li>
          ))
        }
      </ol>
    </section>

    {/* 5. 링크 */}
    <section class="mt-14">
      <h2 class="section-label">links</h2>
      <ul class="mt-3 mb-0 flex flex-col gap-1.5 list-none p-0">
        {
          linkList.map((l) => (
            <li class="grid grid-cols-[4.5rem_1fr] gap-3 font-mono text-caption">
              <span class="text-stone">{l.label}</span>
              <a
                href={l.href}
                class="text-accent underline underline-offset-4 break-all"
                rel="noopener noreferrer"
                target="_blank"
              >
                {l.href}
              </a>
            </li>
          ))
        }
      </ul>
      {d.linksNote && <p class="text-sm text-steel mt-3 mb-0">{d.linksNote}</p>}
    </section>

    <nav class="mt-16 pt-6 border-t border-hairline">
      <a href="/projects/" class="font-mono text-caption text-stone no-underline hover:text-ink">
        ← ~/projects
      </a>
    </nav>
  </article>
</BaseLayout>
